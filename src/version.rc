#include <windows.h>
#include "version.h"
1 VERSIONINFO
 FILEVERSION ELEFUN_VERSION_NUMBERS
 PRODUCTVERSION ELEFUN_VERSION_NUMBERS
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "agammann\0"
   VALUE "FileDescription", "Elefun butterfly catching game\0"
   VALUE "FileVersion", ELEFUN_VERSION "\0"
   VALUE "InternalName", "Elefun\0"
   VALUE "LegalCopyright", "Copyright 2026 agammann\0"
   VALUE "OriginalFilename", "Elefun.exe\0"
   VALUE "ProductName", "Elefun\0"
   VALUE "ProductVersion", ELEFUN_VERSION "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
